# ── Caagil ────────────────────────────────────────────────
# Copy to .env and edit before `npm run dev` or `docker compose up`.

# Public name of the panel (shows in UI + page title)
NEXT_PUBLIC_PANEL_NAME=Caagil

# Used to sign session cookies. Generate: openssl rand -hex 32
AUTH_SECRET=change-me-please-32-bytes-min

# First admin account, created on first boot only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Where SQLite + app data live
DATA_DIR=./data

# Docker socket (Linux default)
DOCKER_SOCKET=/var/run/docker.sock

# Docker network shared with Traefik
PANEL_NETWORK=caagil

# Public URL of the panel behind Traefik (used for links)
PANEL_URL=http://localhost:4000
PANEL_DOMAIN=panel.example.com

# Traefik file-provider directory (panel domain + IP routing)
EDGE_DIR=./edge

# Email for Let's Encrypt (required once you point a domain at the panel)
ACME_EMAIL=
PANEL_DOMAIN=

# ── AI providers (optional — can also be set in Settings UI) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
